{
  "name": "myTome",
  "private": true,
  "version": "0.0.0",
  "description": "A local-first workspace for writing novels.",
  "author": "Art Atikune",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:check": "tsc -p tsconfig.desktop.json --noEmit",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "desktop:dev": "npm run desktop:compile && electron . --dev",
    "desktop:build": "vite build --mode desktop && npm run desktop:compile",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && electron-builder --config desktop/builder.yml",
    "desktop:icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lexical/history": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "lexical": "^0.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
